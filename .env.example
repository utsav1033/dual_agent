# Copy this file to .env and fill in your keys

# HuggingFace token — needed for Qwen2.5 inference (free tier is fine)
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Anthropic/Vercel API key — needed for Claude Haiku via Vercel AI Gateway
# Get one from your Vercel dashboard
ANTHROPIC_API_KEY=vck_your_key_here
